<Window x:Class="DiskMap.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="freedisk.space" Height="820" Width="1280" MinHeight="600" MinWidth="880"
        Background="{DynamicResource RdPage}"
        AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop">
    <!-- The Mac window hides its title bar (.hiddenTitleBar): the page colour runs to the top
         edge and the traffic lights sit in a 32 pt strip above the page bar. Same here: the
         caption is drawn into the client area, with the caption buttons at the strip's right. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <!-- WIN-104: the Mac v0.3.0 shell (AppShellView.swift): the caption strip, a 44 pt page
         bar across the window, a hairline, then the sidebar | page. -->
    <!-- Its own background: the harness renders this grid, not the window, and a transparent
         page area came out black in light-theme shots. -->
    <Grid x:Name="ShellRoot" Background="{DynamicResource RdPage}">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="44" />
            <RowDefinition Height="1" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Caption strip: empty like the Mac's; minimise / maximise / close on the right. -->
        <Border Grid.Row="0" Background="{DynamicResource RdPage}">
            <ContentControl x:Name="CaptionButtonsHost" HorizontalAlignment="Right" />
        </Border>

        <!-- Page bar: page context left; scan status and Rescan right. -->
        <!-- Right 22: the Mac bar ends in a zero-width ⌘K button after a 10 pt gap. -->
        <Border Grid.Row="1" Padding="14,0,22,0" Background="{DynamicResource RdPage}">
            <DockPanel LastChildFill="True">
                <ContentControl x:Name="SidebarButtonHost" DockPanel.Dock="Left" Margin="0,0,10,0"
                                VerticalAlignment="Center" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <ContentControl x:Name="ScanStatusHost" VerticalAlignment="Center" Margin="12,0,10,0" />
                    <ContentControl x:Name="RescanButtonHost" VerticalAlignment="Center" />
                </StackPanel>
                <ContentControl x:Name="PageContextHost" VerticalAlignment="Center" />
            </DockPanel>
        </Border>
        <Border Grid.Row="2" Background="{DynamicResource RdLine}" />

        <!-- Live scan strip: items found, rate, current folder, cancel. -->
        <Border x:Name="ScanBanner" Grid.Row="3" Visibility="Collapsed"
                BorderBrush="{DynamicResource RdLine}" BorderThickness="0,0,0,1"
                Padding="16,6" Background="{DynamicResource RdPage}">
            <DockPanel>
                <ContentControl x:Name="ScanCancelHost" DockPanel.Dock="Right" />
                <ContentControl x:Name="ScanDustyHost" DockPanel.Dock="Right" Margin="0,0,12,0" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="ScanBannerText" FontSize="11.5"
                               Foreground="{DynamicResource RdInk2}" />
                    <ItemsControl x:Name="ScanTopLevels" Margin="0,4,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="220" />
                <ColumnDefinition x:Name="SidebarLineColumn" Width="1" />
                <ColumnDefinition Width="*" />
                <!-- The Mac redesign has no standing inspector; Ctrl+I opens this one. -->
                <ColumnDefinition x:Name="InspectorColumn" Width="0" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar: six destinations, MORE, two more; the basket; Ctrl+K and Settings. -->
            <Border x:Name="SidebarBorder" Grid.Column="0" Background="{DynamicResource RdSidebar}"
                    Padding="9,12,9,10" Panel.ZIndex="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="NavPanel" />
                    </ScrollViewer>
                    <ContentControl x:Name="BasketHost" Grid.Row="1" Margin="0,12,0,0" />
                    <ContentControl x:Name="SidebarFooterHost" Grid.Row="2" />
                </Grid>
            </Border>
            <Border Grid.Column="1" Background="{DynamicResource RdLine}" x:Name="SidebarLine" />

            <ContentControl x:Name="PageHost" Grid.Column="2" />
            <Border x:Name="InspectorBorder" Grid.Column="3" Visibility="Collapsed"
                    BorderBrush="{DynamicResource RdLine}" BorderThickness="1,0,0,0"
                    Background="{DynamicResource RdSidebar}" Panel.ZIndex="5">
                <ContentControl x:Name="InspectorHost" />
            </Border>
        </Grid>

        <!-- Toast: a capsule under the page bar (Mac: 34 tall, raised, hairline, soft shadow). -->
        <Border x:Name="ToastHost" Grid.RowSpan="5" Visibility="Collapsed"
                HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,88,0,0"
                Background="{DynamicResource RdCard}" CornerRadius="17" Height="34"
                BorderBrush="{DynamicResource RdLine}" BorderThickness="1"
                Padding="14,0" Panel.ZIndex="10">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="3" Direction="270" Opacity="0.08" />
            </Border.Effect>
            <TextBlock x:Name="ToastText" Foreground="{DynamicResource RdInk}" FontSize="13"
                       FontWeight="Medium" VerticalAlignment="Center" />
        </Border>
    </Grid>
</Window>
